# Database provider for Prisma: use "postgresql" in production and "sqlite" for local development
DATABASE_PROVIDER="postgresql"

# PostgreSQL database URL for Prisma when using PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/telugu_transliteration"

# Local SQLite database URL for development
# DATABASE_URL="file:./dev.db"

# Admin dashboard secret key for /admin
ADMIN_SECRET="change-this-secret"
