generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transliteration {
  id         Int      @id @default(autoincrement())
  sourceText String
  resultText String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
}
