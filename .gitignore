// filepath: /scripts/cleanup.sh
#!/usr/bin/env bash
set -euo pipefail

# Safe cleanup: untrack common generated/secret files so they won't be committed.
# This only removes files from the git index (keeps local copies).
# Review changes before committing.

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

if [ ! -d .git ]; then
  echo "Error: not a git repository. Initialize git or run this inside the repo root."
  exit 1
fi

echo "Adding .gitignore to index..."
git add .gitignore || true

PATTERNS=(
  "node_modules"
  ".next"
  "out"
  "dist"
  "build"
  ".env"
  ".env.local"
  ".env.*.local"
  "dev.db"
  "*.db"
  "logs"
  "*.log"
  "coverage"
  ".vscode"
  ".idea"
  ".DS_Store"
  "*.tsbuildinfo"
  ".cache"
  "tmp"
)

echo "Removing tracked files that match common ignore patterns (if any)..."
for p in "${PATTERNS[@]}"; do
  # git rm --cached --ignore-unmatch handles cases where the pattern is not tracked
  git rm -r --cached --ignore-unmatch "$p" >/dev/null 2>&1 || true
done

echo
echo "Staged changes summary (git status):"
git status --short --untracked-files=no

echo
echo "Next steps (run these commands to finalize):"
echo "  git add ."
echo "  git commit -m \"chore: add .gitignore and remove ignored files from index\""
echo "  git push origin YOUR_BRANCH"
echo
echo "If you accidentally removed something important from the index, restore with:"
echo "  git reset HEAD -- <path>"
echo
echo "Done. Review staged changes and commit when ready."